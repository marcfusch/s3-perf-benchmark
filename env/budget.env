# Nominal resources of ONE node in the homogeneous reference.
# The cluster budget is 3x these values and stays constant across all
# conditions: limits.sh only changes how it is split between the nodes.
CPU_PER_NODE=1.0
MEM_PER_NODE=1g
# Disk limits applied through cgroup v2 io.max (bytes/s and IOPS).
# Set to about half of what one probe gets when the three run in parallel
# without limits (calibrate_limits.sh, "raw": ~55 MiB/s read, ~150 MiB/s
# write, ~2400 read IOPS, ~2000 write IOPS on the Colima VM disk), so the
# limits and not the host set the pace.
DISK_RBPS=$((25*1024*1024))
DISK_WBPS=$((40*1024*1024))
DISK_RIOPS=800
DISK_WIOPS=600
# Link of each node: egress rate and one way delay, ingress policed to the same rate.
NET_MBIT=1000
NET_DELAY_MS=1
# Resources of the load generator container, outside the cluster budget.
CLIENT_CPUS=2.0
CLIENT_MEM=1g
